<?xml version="1.0" encoding="utf-8"?>
<!-- 冷启动时先把图标亮出来，别给用户一片纯黑。
     ⚠️ 这是 WebView 里 .splash 启动动画的**前一帧**，两者必须看起来是同一个画面，
        否则从原生窗口背景切到 WebView 会「跳一下」（图标忽然变大/位移）。

     对齐关系（2026-09-23 重做启动动画时定的）：
       · 底：#000（与 .splash 的 background 一致，也和网页端一致）
       · 图标居中。WebView 里图标是 128px 逻辑像素，原生这边没有对应单位，
         只能给 dp 近似值；而且这两边**不可能像素级对齐**
         （原生不跑 JS、拿不到设备宽度、也不知道 dpr）。
       · 所以设计上让原生这帧**短、且看起来就是「图标已就位」**，
         WebView 接手时图标从 1.14 缩到 1.00 —— 这点缩放正好把两边的尺寸差吃掉。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
