<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 网页本体。视频进全屏时，这一层会被整个摘掉，换 SurfaceView 上来 -->
    <FrameLayout
        android:id="@+id/webHolder"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/web"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg" />

        <ProgressBar
            android:id="@+id/spin"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent" />

        <!--
          🔴 原生启动遮罩（2026-09-23）。

          为什么需要它：`windowBackground` 只在「Activity 还没画第一帧」时有效 ——
          一旦 contentView（WebView）完成布局，窗口背景就被顶掉了。而此时 WebView 内部
          还在「引擎初始化 → 解析 HTML → 应用 CSS」的过程中，网页里那个 `.splash`
          节点根本还不存在。于是用户看到的是：
              原生图标（windowBackground） → **纯黑空档** → 网页 splash 动画
          中间那段黑就是「看起来像重新开了个 App / 动画又放了一遍」的来源。

          这一层从布局铺好起就一直盖在 WebView 上面，直到网页那边明确说
          「我的 splash 已经接管了」才淡出（`hideSplash()`）。
          它画的**就是同一张启动图**，所以整段过程中用户看到的是连续的一个画面。
        -->
        <ImageView
            android:id="@+id/nativeSplash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/bg"
            android:contentDescription="@null"
            android:scaleType="centerInside"
            android:src="@drawable/native_splash_icon" />
    </FrameLayout>

    <!-- 服务器地址设置：只在连不上（或用户主动按返回键→服务器设置）时露出来 -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="28dp"
            android:paddingTop="76dp"
            android:paddingRight="28dp"
            android:paddingBottom="40dp">

            <ImageView
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:contentDescription="@string/app_name"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/app_name"
                android:textColor="@color/text"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/setup_hint"
                android:textColor="@color/text_dim"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/field_bg"
                android:hint="@string/setup_url_hint"
                android:imeOptions="actionNext"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textColorHint="#FF52525C"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/userInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:hint="WebDAV 账号（可留空）"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textColorHint="#FF52525C"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/passInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:hint="WebDAV 密码"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textColorHint="#FF52525C"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/dirsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:hint="片源文件夹，多个用逗号隔开（留空=根目录）"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:maxLines="2"
                android:paddingLeft="16dp"
                android:paddingTop="14dp"
                android:paddingRight="16dp"
                android:paddingBottom="14dp"
                android:textColor="@color/text"
                android:textColorHint="#FF52525C"
                android:textSize="16sp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_bg"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:text="@string/setup_connect"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/setupStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/setup_tip"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
