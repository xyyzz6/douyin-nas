<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nas.douyin">

    <!--
      ⚠️ minSdkVersion 必须和 build.js 的 APP.minApi 一致（现在是 28）。

      踩过的坑有两层，都要记住：
      1) manifest 里这份会赢过 aapt2 的 min-sdk-version 参数，改 build.js 不够，
         两处必须同时改（build.js 的 checkManifestMinSdk 会硬校验，不一致直接构建失败）。
      2) XML 注释里**不能出现连续两个减号**。早先这条注释里写了 aapt2 的参数名
         （那名字本身含两个减号），直接把 manifest 弄成「not well-formed」，
         结果 aapt2 解析失败、退回默认值，装出来还是旧 minSdk ——
         而构建脚本当时是绿的，只有拿 aapt2 dump badging 才看得出来。

      为什么是 28 而不是 24：内嵌的 ffmpeg/ffprobe 是 NDK r28 为 Android 9 / API 28
      构建的，低于 28 的系统缺它链接的 libc/libm 符号，装上会 dlopen 失败。
      为这个功能明确放弃 Android 7.x 及更老设备（用户已确认）。见 Ffmpeg.java。
    -->
    <uses-sdk
        android:minSdkVersion="28"
        android:targetSdkVersion="34" />

    <!-- 拉流、查网络状态；VIBRATE 是双击点赞时 navigator.vibrate 要用的 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      .strm 本地保存用：把生成的 strm 写进公共目录（如 Download/strm库）。
      API 30+ 走 MANAGE_EXTERNAL_STORAGE（设置页里引导用户授予「所有文件访问」，
      NasBridge.requestStrmStorage 负责跳转）；API 28/29 没有 scoped storage，
      申到 WRITE_EXTERNAL_STORAGE 运行时权限就能直接 File 写。
    -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!--
      应用内更新（2026-09-23）：设置页「版本更新」里下完 APK 后要拉起系统安装器。
      🔴 没有这条权限，`ACTION_VIEW + application/vnd.android.package-archive`
        在 Android 8+ 上会被系统直接**静默拒绝**（不是报错，是压根不弹安装界面），
        表现成「点下载并安装之后什么都没发生」—— 最难查的那种症状。
      ⚠️ 它是**普通权限**（安装时自动授予），不需要运行时申请；但用户仍可能在
        系统设置里手动关掉「允许安装未知应用」，那种情况下要引导他去开
        （见 MainActivity 的 canRequestPackageInstalls 分支）。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      🔴 android:extractNativeLibs="true" 是**内置 CloudDrive2 引擎的前提**，别删。
         它让系统在安装时把 lib/<abi>/*.so 解压到 /data/app/<pkg>/lib/<abi>/，
         而那是**唯一允许本应用 execve 的路径**（Android 10 起私有目录 W^X，不许执行）。
         若改成 false（AGP 的默认值），二进制就留在 APK 里、nativeLibraryDir 指向包内，
         没法当独立进程跑 —— 表现是「装得上、跑不起来、内置网盘永远连不上」。

      ⚠️ PlayerActivity 用的是系统 MediaCodec + Media3，没有自己的 .so。
    -->
    <application
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">

        <!--
          configChanges 一定要全写：视频进全屏会转屏、键盘弹出也会触发配置变更，
          不声明的话 Activity 会被重建 —— 表现是「一按全屏就从头加载」。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          应用内更新用的 FileProvider（2026-09-23）。

          ⚠️ 用的是**自己写的** `UpdateProvider`，不是 androidx.core 的 FileProvider ——
             本项目没有 Gradle，第三方库靠 android/libs 手工铺开，
             为一个类引进整个 androidx.core（1MB+ 还带连锁依赖）不划算。
             见 UpdateProvider.java 的类注释。

          🔴 authorities 必须与 `UpdateProvider.AUTHORITY`、
             MainActivity 里 `getUriForFile` 用的字符串三处一致。
          exported=false + grantUriPermissions=true 是标准姿势：自己不对外暴露，
          只在拉起安装器时**临时**把那个 Uri 的读权限授给系统安装器。
          meta-data 必须指向更新专用白名单（res/xml/update_paths.xml），
          只有它放行 cacheDir/update —— 别指向开放式路径。
        -->
        <provider
            android:name=".UpdateProvider"
            android:authorities="com.nas.douyin.update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!--
          原生全屏播放器：独立 Activity，不跟 WebView 同屏。
          网页里点「全屏」时由 NasBridge.openPlayer 拉起，用系统 MediaCodec 硬解。
        -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/AppTheme" />

        <!--
          内置 CloudDrive2 引擎的管理页（登录 CD2 账号、挂载 115 / 夸克 / 阿里云盘…）。
          由 MainActivity 的 NasBridge.cd2Admin() 拉起，页面只是访问 127.0.0.1:19798。
        -->
        <activity
            android:name=".Cd2Activity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|navigation"
            android:exported="false"
            android:label="CloudDrive2 管理"
            android:theme="@style/AppTheme" />

    </application>
</manifest>
